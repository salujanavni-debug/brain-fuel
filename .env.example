# GEMINI_API_KEY: Required if optional Gemini AI features are configured server-side.
# Users configure secrets securely in the server environment (never exposed to browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Client-side public values only)
# Create a free project at https://supabase.com and run /supabase/migrations/*.sql
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
