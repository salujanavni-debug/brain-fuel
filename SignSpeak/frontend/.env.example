# SignSpeak Frontend Environment Variables
# Copy to .env locally. Never put service role keys or secrets in VITE_* variables.

VITE_API_BASE_URL="http://localhost:8000"

# Supabase PostgreSQL + Auth (Public Anon Key only)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
