# SignSpeak Backend Environment Variables
# Copy this file to .env and fill in real values locally.
# NEVER commit .env or expose service role keys to the frontend.

APP_NAME="SignSpeak API"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Binding
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api"

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Recognition Model Settings
MIN_CONFIDENCE_THRESHOLD=0.65
MEDIAPIPE_HAND_LANDMARKER_TASK="./models/hand_landmarker.task"
GESTURE_MODEL_PATH="./models/signspeak_gesture_classifier.keras"

# Supabase PostgreSQL (Server-side only — never expose service role keys to frontend)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
